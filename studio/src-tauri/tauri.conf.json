{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tang FPGA Studio",
  "version": "3.0.0",
  "identifier": "dev.fpgastudio.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tang FPGA Studio",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'",
      "capabilities": ["default"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": false,
    "category": "DeveloperTool",
    "shortDescription": "FPGA development without the friction",
    "longDescription": "A local-first, beginner-friendly professional FPGA workspace for Tang boards.",
    "windows": {
      "wix": { "language": "en-US" },
      "nsis": { "displayLanguageSelector": false, "installerIcon": "icons/icon.ico" }
    },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
