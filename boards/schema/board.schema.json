{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fpgastudio.dev/schemas/board-v1.json",
  "title": "FPGA Studio board package",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "name", "vendor", "family", "device", "clocks", "programmer", "constraints"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "vendor": { "type": "string" },
    "family": { "type": "string" },
    "yosysFamily": { "type": "string" },
    "device": { "type": "string" },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backend", "deviceName"],
      "properties": {
        "backend": { "enum": ["oss-cad-suite", "gowin-eda"] },
        "deviceName": { "type": "string", "minLength": 2 },
        "deviceCode": { "type": "string", "minLength": 2 },
        "deviceVersion": { "enum": ["A", "B", "C"] }
      }
    },
    "logicCells": { "type": "integer", "minimum": 1 },
    "clocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "frequencyHz", "pin"],
        "properties": {
          "name": { "type": "string" },
          "frequencyHz": { "type": "integer", "minimum": 1 },
          "pin": { "type": "string" },
          "ioStandard": { "type": "string" }
        }
      }
    },
    "programmer": {
      "type": "object",
      "required": ["backend", "board", "transport"],
      "properties": {
        "backend": { "enum": ["openFPGALoader"] },
        "board": { "type": "string" },
        "transport": { "enum": ["ftdi-mpsse", "bl616", "cmsis-dap", "dirty-jtag", "external-jtag"] },
        "jtagInterface": { "type": "integer", "minimum": 0 },
        "uartInterface": { "type": "integer", "minimum": 0 },
        "usbVid": { "type": "string", "pattern": "^[0-9A-Fa-f]{4}$" },
        "usbPid": { "type": "string", "pattern": "^[0-9A-Fa-f]{4}$" }
      }
    },
    "constraints": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "timingConstraints": { "type": "array", "items": { "type": "string" } },
    "documentation": { "type": "string" },
    "capabilities": { "type": "array", "items": { "type": "string" } }
  }
}
